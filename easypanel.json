{
  "deploy": {
    "type": "docker-compose",
    "dockerCompose": {
      "path": "docker-compose.yml"
    }
  },
  "volumes": ["pgdata"],
  "env": {
    "JWT_SECRET": {
      "description": "JWT signing secret",
      "required": true
    },
    "SESSION_SECRET": {
      "description": "Session secret",
      "required": true
    },
    "GOOGLE_CLIENT_ID": {
      "description": "Google OAuth client ID (server-side token verification)",
      "required": false
    },
    "VITE_GOOGLE_CLIENT_ID": {
      "description": "Google OAuth client ID baked into the frontend build",
      "required": false
    }
  }
}
