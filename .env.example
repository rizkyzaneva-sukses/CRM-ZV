# Database
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_db

# Server
PORT=3001
NODE_ENV=production

# JWT Secret
JWT_SECRET=change-this-to-a-random-secret

# Session
SESSION_SECRET=change-this-to-another-random-secret

# Google OAuth - wajib kalau tombol "Login with Google" dipakai.
# Server memverifikasi token dengan GOOGLE_CLIENT_ID; client di-build dengan
# VITE_GOOGLE_CLIENT_ID (nilainya sama, di-inject saat build).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# CORS - kosongkan kalau frontend disajikan dari server yang sama (default).
# Isi dengan daftar origin dipisah koma bila client dideploy terpisah.
CORS_ORIGIN=
