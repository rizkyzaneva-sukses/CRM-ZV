{
  "name": "crm-server",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "dev": "node index.js",
    "migrate": "node utils/migrate.js",
    "seed": "node utils/seed.js",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:db": "docker run -d --rm --name crm-test-db -e POSTGRES_USER=crm_user -e POSTGRES_PASSWORD=crm_password -e POSTGRES_DB=crm_test -p 55432:5432 postgres:16-alpine",
    "test:db:stop": "docker rm -f crm-test-db"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "testEnvironment": "node",
    "testTimeout": 30000,
    "maxWorkers": 1
  }
}
